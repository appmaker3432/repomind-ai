# Optional local Ollama service. The default points to the same machine as the backend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this to a model already installed in Ollama. No model is selected automatically.
OLLAMA_MODEL=

# Optional OpenAI API adapter. Keep real credentials in backend/.env, never source control.
OPENAI_API_KEY=
# Set to a model identifier enabled for your API account.
OPENAI_MODEL=

# Optional Google Gemini API adapter. Store real credentials only in the backend environment.
GEMINI_API_KEY=
# Set to a Gemini model identifier enabled for your API key.
GEMINI_MODEL=

# Comma-separated exact browser origins allowed to call this backend.
# Add the deployed Render Static Site origin here; do not use "*".
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request timeout for GitHub and OSV HTTP requests.
REQUEST_TIMEOUT_SECONDS=12
# Overall analysis deadline.
MAX_ANALYSIS_SECONDS=60
